{
    "include": [
        "."
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        "venv"
    ],
    "extraPaths": [
        "./venv/Lib/site-packages"
    ],
    "pythonVersion": "3.13",
